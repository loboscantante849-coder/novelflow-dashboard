# Discord Interactions endpoint verification
DISCORD_PUBLIC_KEY=

# Run scripts/register-discord.js locally only; do not add the bot token to Vercel.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Long-lived Discord Gateway worker. This token is used only by the worker,
# never by Vercel Functions. Reuse neither the interaction public key nor an API token.
DISCORD_GATEWAY_SECRET=
DISCORD_GATEWAY_SEARCH_URL=https://social.novelflow.top/api/discord-gateway-search

# Restrict the assistant before inviting it to a production server.
NOVELFLOW_DISCORD_ALLOWED_GUILD_IDS=
NOVELFLOW_DISCORD_ALLOWED_ROLE_IDS=
NOVELFLOW_DISCORD_OPERATOR_TOKEN=

# Verified Discord attribution configuration from NovelFlow administration.
NOVELFLOW_DISCORD_PROMOTER=
NOVELFLOW_DISCORD_CHANNEL_NAME_ID=
NOVELFLOW_DISCORD_CHANNEL_SOURCE=Discord
NOVELFLOW_DISCORD_CHANNEL_CODE=DISCORD

# OCR adapter. Use an approved vision-capable model endpoint.
NOVELFLOW_OCR_MODEL=
NOVELFLOW_OCR_API_KEY=
NOVELFLOW_OCR_BASE_URL=

# Isolated social-console state. Configure one storage option.
KV_REST_API_URL=
KV_REST_API_TOKEN=
SOCIAL_STORE_URL=
SOCIAL_STORE_SECRET=
CRON_SECRET=

# Private console access. Use a unique password and a random secret with at
# least 32 characters. Both are required; the console fails closed without them.
SOCIAL_CONSOLE_PASSWORD=
SOCIAL_CONSOLE_SESSION_SECRET=
# Set to true only for a private operator console. This removes the browser login.
SOCIAL_CONSOLE_OPEN_ACCESS=false
# Required only when OPEN_ACCESS is true. Keep this server-side; do not place
# it in the browser. It protects mutations that can spend on media providers.
SOCIAL_CONSOLE_OPERATOR_TOKEN=

# IIIT is the authorized P0-P7 poster and character-reference provider.
IIIT_IMAGE_API_KEY=
IIIT_IMAGE_BASE_URL=https://ai.iiit.cn/v1
IIIT_IMAGE_MODEL=IMG-2
# Comma-separated exact HTTPS hosts returned by the provider, only when a
# result CDN differs from ai.iiit.cn. This is an allowlist, not a URL input.
IIIT_IMAGE_MEDIA_HOSTS=

# Private allowlisted ad performance. Keep access tokens server-side only.
# The Meta account is fixed in code to the approved account 915817154893411.
META_MARKETING_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_GRAPH_API_BASE_URL=

# Beidou data is campaign-level and is joined only when an exact campaign
# name is registered for a Meta ad. It is never treated as ad-level data.
BEIDOU_REPORT_TOKEN=
BEIDOU_REPORT_URL=https://beidou.win/api/v1/event-analysis-report/query-report
BEIDOU_PROJECT_ID=1006

# SocialEcho is called only by Vercel Functions after operator approval.
SOCIALECHO_API_KEY=
SOCIALECHO_API_BASE_URL=https://api.socialecho.net
# New completed NovelFlow runs create a SocialEcho draft on this verified account.
SOCIALECHO_AUTO_DRAFT=false
SOCIALECHO_DEFAULT_ACCOUNT_ID=

# Tianji AC video service (server-side only; never expose these in the browser)
AC_API_BASE_URL=https://ac.anynovel.app/api/v1
AC_PROJECT_ID=1006
AC_TOKEN=
# Legacy compatibility fallback (prefer AC_TOKEN above)
NOVELFLOW_AC_TOKEN=

# Local AC paid-request points guard. AC currently exposes no documented
# billable-points ledger to this app, so each create/retry reserves the
# configured estimate before POST. The daily limit is hard-capped at 1000.
AC_DAILY_POINTS_LIMIT=1000
AC_VIDEO_COST_POINTS=1
AC_RETRY_COST_POINTS=1
AC_REQUEST_COST_POINTS=1

# Existing NovelFlow bookstore/ranking authentication.
NOVELFLOW_APPLICATION_ID=
NOVELFLOW_OIDC_TOKEN=
NOVELFLOW_OIDC_USERNAME=
NOVELFLOW_OIDC_PASSWORD=
NOVELFLOW_REPORT_TOKEN=

# TokenDance OpenAI-compatible route. The logical `deepseek` choice is pinned
# Server-side TokenDance access; never expose this key to the browser.
NOVELFLOW_TOKENDANCE_API_KEY=
NOVELFLOW_LLM_MODEL_GLM_5_3_FLASH=glm-5.3-flash
NOVELFLOW_LLM_MODEL_DEEPSEEK_V4_FLASH_PREVIEW=deepseek-v4-flash-preview

# Global paid-video submission gate. Existing threadIds are still polled, but
# waiting/prepared tasks are never submitted while this is true.
SOCIAL_VIDEO_GENERATION_PAUSED=true
# Keeps newly prepared IIIT posters from spending automatically. Existing
# persisted external image tasks may still be polled and recovered.
SOCIAL_IMAGE_GENERATION_PAUSED=true
SOCIAL_VIDEO_DAILY_LIMIT_OVERRIDE=
SOCIAL_KV_REST_API_URL=
SOCIAL_KV_REST_API_TOKEN=
SOCIAL_AD_CAMPAIGN_TOKEN_V2=
